{
  "expo": {
    "name": "Video Player",
    "slug": "video-player",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.yourname.videoplayer",
      "versionCode": 1,
      "permissions": ["INTERNET", "WAKE_LOCK"]
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ]
  }
}
